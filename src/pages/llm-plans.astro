---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { url } from '../utils/paths';
import llmPlans from '../data/llm-plans.json';

// Filter by origin
const international = llmPlans.filter(p => p.origin === 'international');
const domestic = llmPlans.filter(p => p.origin === 'domestic');
const totalPlans = llmPlans.reduce((acc, c) => acc + c.plans.length, 0);

// Helpers
const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const marketBadge = (market: string) => {
  if (market === 'international') return { label: '🌐 International', cls: 'badge-intl' };
  if (market === 'china') return { label: '🇨🇳 China', cls: 'badge-cn' };
  return { label: market, cls: '' };
};

const typeIcon = (type: string) => {
  if (type === 'subscription') return '🔑';
  if (type === 'api') return '⚙️';
  return '📋';
};

const companyMarkets = (markets: string[]) => {
  const parts: string[] = [];
  if (markets.includes('international')) parts.push('International');
  if (markets.includes('china')) parts.push('China');
  return parts.join(' + ');
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`LLM Plans & Pricing | ${SITE_TITLE}`} description="Comparison of LLM subscription plans and API pricing from major AI companies worldwide. Updated daily." />
	</head>
	<body>
		<Header />
		<main class="llm-plans-page">
			<header class="page-header">
				<p class="eyebrow">LLM Pricing Reference</p>
				<h1>LLM Plans &amp; Pricing</h1>
				<p class="page-subtitle">
					A curated comparison of subscription plans and API pricing from major LLM providers.
					<span class="plan-summary">{llmPlans.length} companies · {totalPlans} plans</span>
				</p>
				<div class="view-toggle" role="tablist" aria-label="View mode">
					<button class="view-toggle-btn active" data-view="grid" role="tab" aria-selected="true" type="button">Grid</button>
					<button class="view-toggle-btn" data-view="list" role="tab" aria-selected="false" type="button">List</button>
				</div>
				<p class="last-updated">Last updated: {formatDate(new Date())} · Data from official sources</p>
			</header>

			<!-- ═══════════ GRID VIEW ═══════════ -->
			<div class="plans-view plans-view-grid" id="gridView">
				<!-- International Section -->
				<section class="plans-section">
					<p class="section-eyebrow">01 / Overseas</p>
					<h2 class="section-title">
						<span class="section-icon">🌍</span>
						International
						<span class="company-count">{international.length}</span>
					</h2>
					<p class="section-desc">Overseas AI companies and their product plans</p>

					<div class="company-grid">
						{international.map((company) => (
							<article class="company-card">
								<div class="card-header">
									<div class="company-title-row">
										<h3 class="company-name">
											<a href={company.homepage} target="_blank" rel="noopener noreferrer">{company.name}</a>
										</h3>
										<span class="company-markets">{companyMarkets(company.marketsServed)}</span>
									</div>
									<p class="company-desc">{company.description}</p>
								</div>

								<div class="plans-list">
									{company.plans.map((plan) => {
										const badge = marketBadge(plan.market);
										return (
											<a href={plan.url} target="_blank" rel="noopener noreferrer" class="plan-item">
												<div class="plan-info">
													<div class="plan-name-row">
														<span class="plan-type-icon">{typeIcon(plan.type)}</span>
														<span class="plan-name">{plan.name}</span>
														<span class={`market-badge ${badge.cls}`}>{badge.label}</span>
													</div>
													<p class="plan-desc">{plan.description}</p>
												</div>
												<div class="plan-price">
													<span class="price-value">{plan.price}</span>
													<svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
												</div>
											</a>
										);
									})}
								</div>
							</article>
						))}
					</div>
				</section>

				<!-- Domestic Section -->
				<section class="plans-section">
					<p class="section-eyebrow">02 / Domestic</p>
					<h2 class="section-title">
						<span class="section-icon">🇨🇳</span>
						Domestic
						<span class="company-count">{domestic.length}</span>
					</h2>
					<p class="section-desc">Chinese AI companies and their product plans</p>

					<div class="company-grid">
						{domestic.map((company) => (
							<article class="company-card">
								<div class="card-header">
									<div class="company-title-row">
										<h3 class="company-name">
											<a href={company.homepage} target="_blank" rel="noopener noreferrer">{company.name}</a>
										</h3>
										<span class="company-markets">{companyMarkets(company.marketsServed)}</span>
									</div>
									<p class="company-desc">{company.description}</p>
								</div>

								<div class="plans-list">
									{company.plans.map((plan) => {
										const badge = marketBadge(plan.market);
										return (
											<a href={plan.url} target="_blank" rel="noopener noreferrer" class="plan-item">
												<div class="plan-info">
													<div class="plan-name-row">
														<span class="plan-type-icon">{typeIcon(plan.type)}</span>
														<span class="plan-name">{plan.name}</span>
														<span class={`market-badge ${badge.cls}`}>{badge.label}</span>
													</div>
													<p class="plan-desc">{plan.description}</p>
												</div>
												<div class="plan-price">
													<span class="price-value">{plan.price}</span>
													<svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
												</div>
											</a>
										);
									})}
								</div>
							</article>
						))}
					</div>
				</section>
			</div>

			<!-- ═══════════ LIST VIEW (accordion) ═══════════ -->
			<div class="plans-view plans-view-list" id="listView" hidden>
				<section class="plans-section list-section">
					<p class="section-eyebrow">01 / Overseas</p>
					<h2 class="section-title">
						<span class="section-icon">🌍</span>
						International
						<span class="company-count">{international.length}</span>
					</h2>
					<p class="section-desc">Click a company to expand its plans.</p>

					<div class="accordion-list" data-section="intl">
						{international.map((company, i) => (
							<article class="accordion-row" id={`intl-${i}`}>
								<button class="accordion-header" type="button" aria-expanded="false" aria-controls={`intl-${i}-body`}>
									<span class="accordion-chevron" aria-hidden="true">
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
									</span>
									<span class="accordion-name">{company.name}</span>
									<span class="accordion-markets">{companyMarkets(company.marketsServed)}</span>
									<span class="accordion-meta">{company.plans.length} plan{company.plans.length > 1 ? 's' : ''}</span>
								</button>
								<div class="accordion-body" id={`intl-${i}-body`} role="region">
									<div class="accordion-body-inner">
										<p class="accordion-desc">{company.description}</p>
										<div class="accordion-plans">
											{company.plans.map((plan) => {
												const badge = marketBadge(plan.market);
												return (
													<a href={plan.url} target="_blank" rel="noopener noreferrer" class="accordion-plan">
														<div class="plan-info">
															<div class="plan-name-row">
																<span class="plan-type-icon">{typeIcon(plan.type)}</span>
																<span class="plan-name">{plan.name}</span>
																<span class={`market-badge ${badge.cls}`}>{badge.label}</span>
															</div>
															<p class="plan-desc">{plan.description}</p>
														</div>
														<div class="plan-price">
															<span class="price-value">{plan.price}</span>
															<svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
														</div>
													</a>
												);
											})}
										</div>
									</div>
								</div>
							</article>
						))}
					</div>
				</section>

				<section class="plans-section list-section">
					<p class="section-eyebrow">02 / Domestic</p>
					<h2 class="section-title">
						<span class="section-icon">🇨🇳</span>
						Domestic
						<span class="company-count">{domestic.length}</span>
					</h2>
					<p class="section-desc">Click a company to expand its plans.</p>

					<div class="accordion-list" data-section="cn">
						{domestic.map((company, i) => (
							<article class="accordion-row" id={`cn-${i}`}>
								<button class="accordion-header" type="button" aria-expanded="false" aria-controls={`cn-${i}-body`}>
									<span class="accordion-chevron" aria-hidden="true">
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
									</span>
									<span class="accordion-name">{company.name}</span>
									<span class="accordion-markets">{companyMarkets(company.marketsServed)}</span>
									<span class="accordion-meta">{company.plans.length} plan{company.plans.length > 1 ? 's' : ''}</span>
								</button>
								<div class="accordion-body" id={`cn-${i}-body`} role="region">
									<div class="accordion-body-inner">
										<p class="accordion-desc">{company.description}</p>
										<div class="accordion-plans">
											{company.plans.map((plan) => {
												const badge = marketBadge(plan.market);
												return (
													<a href={plan.url} target="_blank" rel="noopener noreferrer" class="accordion-plan">
														<div class="plan-info">
															<div class="plan-name-row">
																<span class="plan-type-icon">{typeIcon(plan.type)}</span>
																<span class="plan-name">{plan.name}</span>
																<span class={`market-badge ${badge.cls}`}>{badge.label}</span>
															</div>
															<p class="plan-desc">{plan.description}</p>
														</div>
														<div class="plan-price">
															<span class="price-value">{plan.price}</span>
															<svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
														</div>
													</a>
												);
											})}
										</div>
									</div>
								</div>
							</article>
						))}
					</div>
				</section>
			</div>

			<footer class="page-footer-note">
				<p>Prices and plans are subject to change. Data collected from official sources. 
				<a href="https://github.com/cyclone/Shouyu-blog" target="_blank" rel="noopener noreferrer">Submit a correction</a>.</p>
			</footer>
		</main>
		<Footer />
	</body>
</html>

<style>
  /* ── Page Layout ── */
  .llm-plans-page {
    --ease: cubic-bezier(0.32, 0.72, 0, 1);
    max-width: none;
    padding: 5rem 1.5rem 4rem;
  }

  /* ── Eyebrow micro-label ── */
  .eyebrow,
  .section-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
    line-height: 1;
  }
  .eyebrow { margin-bottom: 0.5rem; }

  /* ── Page Header ── */
  .page-header { margin-bottom: 3rem; }
  .page-header h1 {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
    color: var(--color-text-main);
  }
  .page-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 0.25rem;
  }
  .plan-summary {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.15rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 500;
    background-color: var(--color-bg-offset);
    border-radius: 999px;
    color: var(--color-text-muted);
  }
  .last-updated {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0.75rem 0 0;
    opacity: 0.7;
  }

  /* ── View Toggle — ghost segmented control, shadow-as-border, NO solid fill ── */
  .view-toggle {
    display: inline-flex;
    margin: 1.25rem 0 0;
    padding: 3px;
    background: transparent;
    border-radius: 6px;
    box-shadow: 0 0 0 1px var(--color-border);
  }
  .view-toggle-btn {
    padding: 0.35rem 0.85rem;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    border-radius: 4px;
    transition: color 0.25s var(--ease), box-shadow 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .view-toggle-btn:hover {
    color: var(--color-text-main);
  }
  .view-toggle-btn.active {
    color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
    background: transparent;
  }
  .view-toggle-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--color-accent);
  }

  /* ── Plans View Wrapper ── */
  .plans-view[hidden] { display: none; }

  /* ── Section ── */
  .plans-section {
    margin-bottom: 3.5rem;
    scroll-margin-top: 5rem;
  }
  .plans-section:last-of-type { margin-bottom: 2rem; }
  .section-title {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: none;
    padding-bottom: 0;
    color: var(--color-text-main);
    letter-spacing: -0.01em;
  }
  .section-icon { font-size: 1.35rem; }
  .company-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: transparent;
    border-radius: 999px;
    box-shadow: 0 0 0 1px var(--color-border);
  }
  .section-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }

  /* ════════════════════════════════════════
     GRID VIEW (refined)
     ════════════════════════════════════════ */
  .company-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 1.25rem;
  }
  .company-card {
    border: none;
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--color-bg);
    /* Stripe shadow-as-border + subtle elevation */
    box-shadow: 0 0 0 1px var(--color-border), 0 2px 4px rgba(0, 0, 0, 0.03);
    transition: box-shadow 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .company-card:hover {
    /* Multi-layer blue-tinted shadow on hover */
    box-shadow:
      0 0 0 1px var(--color-border),
      0 12px 28px -10px rgba(0, 51, 102, 0.14),
      0 4px 12px -4px rgba(0, 0, 0, 0.05);
    transform: translateY(-2px);
  }

  .card-header {
    padding: 1.2rem 1.5rem 0.75rem;
    /* shadow-as-border in place of the bottom border */
    box-shadow: 0 1px 0 0 var(--color-border);
  }
  .company-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .company-name {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .company-name a {
    color: var(--color-text-main);
    text-decoration: none;
    border: none;
    transition: color 0.2s var(--ease);
  }
  .company-name a:hover { color: var(--color-accent); }
  .company-markets {
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background-color: var(--color-bg-offset);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .company-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
    font-weight: 400;
  }

  /* ── Plans List (Grid view) ── */
  .plans-list { display: flex; flex-direction: column; }
  .plan-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.5rem;
    text-decoration: none;
    color: var(--color-text-main);
    /* shadow-as-border between rows instead of border-bottom */
    box-shadow: 0 1px 0 0 var(--color-border);
    transition: background-color 0.25s var(--ease);
  }
  .plan-item:last-child { box-shadow: none; }
  .plan-item:hover { background-color: var(--color-bg-offset); }

  .plan-info { flex: 1; min-width: 0; }
  .plan-name-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.2rem;
  }
  .plan-type-icon { font-size: 0.9rem; flex-shrink: 0; }
  .plan-name { font-size: 0.95rem; font-weight: 600; }
  .plan-desc {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
    word-break: keep-all;
    overflow-wrap: break-word;
    font-weight: 400;
  }

  /* ── Price ── */
  .plan-price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    text-align: right;
    max-width: 45%;
    word-break: keep-all;
    overflow-wrap: break-word;
  }
  .price-value {
    font-size: 0.92rem;
    font-weight: 600;
    white-space: nowrap;
    font-feature-settings: "tnum" 1;
  }
  .arrow-icon {
    color: var(--color-text-muted);
    opacity: 0.4;
    flex-shrink: 0;
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .plan-item:hover .arrow-icon,
  .accordion-plan:hover .arrow-icon {
    opacity: 0.8;
    transform: translateX(3px);
  }

  /* ── Market Badges ── */
  .market-badge {
    display: inline-block;
    font-size: 0.66rem;
    font-weight: 600;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    white-space: nowrap;
    line-height: 1.4;
  }
  .badge-intl {
    background-color: rgba(100, 100, 255, 0.10);
    color: #5555cc;
  }
  :global(html[data-theme="dark"]) .badge-intl {
    background-color: rgba(120, 120, 255, 0.18);
    color: #9999ff;
  }
  .badge-cn {
    background-color: rgba(255, 70, 70, 0.10);
    color: #cc3333;
  }
  :global(html[data-theme="dark"]) .badge-cn {
    background-color: rgba(255, 100, 100, 0.15);
    color: #ff7777;
  }

  /* ════════════════════════════════════════
     LIST VIEW — Stripe-docs-style accordion
     ════════════════════════════════════════ */
  .plans-view-list {
    max-width: 820px;
    margin: 0 auto;
  }

  .list-section { margin-bottom: 3.5rem; }

  .accordion-list {
    display: flex;
    flex-direction: column;
    /* shadow-as-border at list container boundary */
    box-shadow: 0 0 0 1px var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--color-bg);
  }

  .accordion-row + .accordion-row {
    /* shadow-as-border between rows */
    box-shadow: 0 1px 0 0 var(--color-border) inset;
  }

  /* Header row — the always-visible strip */
  .accordion-header {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.05rem 1.25rem;
    border: none;
    background: transparent;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-sans);
    color: var(--color-text-main);
    transition: background-color 0.25s var(--ease);
  }
  .accordion-header:hover { background-color: var(--color-bg-offset); }
  .accordion-header:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--color-accent);
  }

  .accordion-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: transform 0.3s var(--ease), color 0.2s var(--ease);
  }
  .accordion-row.expanded .accordion-chevron {
    transform: rotate(90deg);
    color: var(--color-accent);
  }

  .accordion-name {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-main);
    letter-spacing: -0.01em;
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .accordion-markets {
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background-color: var(--color-bg-offset);
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .accordion-meta {
    font-size: 0.74rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    font-feature-settings: "tnum" 1;
    flex-shrink: 0;
    min-width: 4.5rem;
    text-align: right;
  }

  /* Body — animated with grid-template-rows trick (no max-height jank) */
  .accordion-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s var(--ease);
  }
  .accordion-row.expanded .accordion-body {
    grid-template-rows: 1fr;
  }
  .accordion-body-inner {
    overflow: hidden;
    min-height: 0;
    /* shadow-as-border between header and body */
    box-shadow: 0 1px 0 0 var(--color-border) inset;
  }
  .accordion-row.expanded .accordion-body-inner {
    padding: 1rem 1.25rem 1.25rem 3.5rem;
  }

  .accordion-desc {
    font-size: 0.86rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0 0 0.75rem;
    word-break: keep-all;
    overflow-wrap: break-word;
    font-weight: 400;
  }

  .accordion-plans {
    display: flex;
    flex-direction: column;
  }
  .accordion-plan {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0.75rem;
    text-decoration: none;
    color: var(--color-text-main);
    border-radius: 6px;
    box-shadow: 0 1px 0 0 var(--color-border);
    transition: background-color 0.2s var(--ease);
  }
  .accordion-plan:last-child { box-shadow: none; }
  .accordion-plan:hover {
    background-color: var(--color-bg-offset);
  }

  /* ── Footer Note ── */
  .page-footer-note {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    box-shadow: 0 -1px 0 0 var(--color-border);
  }
  .page-footer-note p {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0;
    text-align: center;
  }
  .page-footer-note a { color: var(--color-accent); }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .plan-price { max-width: 40%; }
  }

  @media (max-width: 720px) {
    .page-header h1 { font-size: 1.85rem; }
    .company-grid { grid-template-columns: 1fr; }
    .plan-item,
    .accordion-plan {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
    .plan-price {
      width: 100%;
      max-width: none;
      justify-content: flex-end;
      padding-left: 1.2rem;
    }
