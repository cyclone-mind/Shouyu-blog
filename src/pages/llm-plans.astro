    .plan-desc { line-height: 1.45; }
    .section-title { font-size: 1.2rem; }

    /* Accordion mobile */
    .accordion-header { padding: 0.95rem 1rem; gap: 0.65rem; }
    .accordion-name { font-size: 1rem; white-space: normal; }
    .accordion-meta { display: none; }
    .accordion-row.expanded .accordion-body-inner {
      padding: 0.85rem 1rem 1rem 2.6rem;
    }
  }
</style>

<script is:inline>
  (function () {
    const toggleBtns = document.querySelectorAll('.view-toggle-btn');
    const gridView = document.getElementById('gridView');
    const listView = document.getElementById('listView');

    function setView(view) {
      toggleBtns.forEach(function (b) {
        const active = b.dataset.view === view;
        b.classList.toggle('active', active);
        b.setAttribute('aria-selected', String(active));
      });
      gridView.hidden = view !== 'grid';
      listView.hidden = view !== 'list';
      try { sessionStorage.setItem('llm-plans-view', view); } catch (e) {}
    }

    toggleBtns.forEach(function (b) {
      b.addEventListener('click', function () { setView(b.dataset.view); });
    });

    let saved = null;
    try { saved = sessionStorage.getItem('llm-plans-view'); } catch (e) {}
    if (saved === 'stack' || saved === 'list') setView('list');
    else if (saved === 'grid') setView('grid');

    // Accordion — only one open per section at a time.
    document.querySelectorAll('.accordion-list').forEach(function (list) {
      const rows = list.querySelectorAll('.accordion-row');
      rows.forEach(function (row) {
        const header = row.querySelector('.accordion-header');
        header.addEventListener('click', function () {
          const isOpen = row.classList.contains('expanded');
          rows.forEach(function (r) {
            r.classList.remove('expanded');
            const h = r.querySelector('.accordion-header');
            if (h) h.setAttribute('aria-expanded', 'false');
          });
          if (!isOpen) {
            row.classList.add('expanded');
            header.setAttribute('aria-expanded', 'true');
          }
        });
      });
    });
  })();
</script>