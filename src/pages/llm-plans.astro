---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { url } from '../utils/paths';
import llmPlans from '../data/llm-plans.json';

// Filter by origin
const international = llmPlans.filter(p => p.origin === 'international');
const domestic = llmPlans.filter(p => p.origin === 'domestic');
const totalPlans = llmPlans.reduce((acc, c) => acc + c.plans.length, 0);

// Helpers
const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const marketBadge = (market: string) => {
  if (market === 'international') return { label: '🌐 International', cls: 'badge-intl' };
  if (market === 'china') return { label: '🇨🇳 China', cls: 'badge-cn' };
  return { label: market, cls: '' };
};

const typeIcon = (type: string) => {
  if (type === 'subscription') return '🔑';
  if (type === 'api') return '⚙️';
  return '📋';
};

const companyMarkets = (markets: string[]) => {
  const parts: string[] = [];
  if (markets.includes('international')) parts.push('International');
  if (markets.includes('china')) parts.push('China');
  return parts.join(' + ');
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`LLM Plans & Pricing | ${SITE_TITLE}`} description="Comparison of LLM subscription plans and API pricing from major AI companies worldwide. Updated daily." />
	</head>
	<body>
		<Header />
		<main class="llm-plans-page">
			<header class="page-header">
				<h1>LLM Plans &amp; Pricing</h1>
				<p class="page-subtitle">
          A curated comparison of subscription plans and API pricing from major LLM providers.
          <span class="plan-summary">{llmPlans.length} companies · {totalPlans} plans</span>
        </p>
				<p class="last-updated">Last updated: {formatDate(new Date())} · Data from official sources</p>
			</header>

      <!-- International Section -->
      <section class="plans-section">
        <h2 class="section-title">
          <span class="section-icon">🌍</span>
          International
          <span class="company-count">{international.length}</span>
        </h2>
        <p class="section-desc">Overseas AI companies and their product plans</p>

        <div class="company-grid">
          {international.map((company) => (
            <article class="company-card">
              <div class="card-header">
                <div class="company-title-row">
                  <h3 class="company-name">
                    <a href={company.homepage} target="_blank" rel="noopener noreferrer">{company.name}</a>
                  </h3>
                  <span class="company-markets">{companyMarkets(company.marketsServed)}</span>
                </div>
                <p class="company-desc">{company.description}</p>
              </div>

              <div class="plans-list">
                {company.plans.map((plan) => {
                  const badge = marketBadge(plan.market);
                  return (
                    <a href={plan.url} target="_blank" rel="noopener noreferrer" class="plan-item">
                      <div class="plan-info">
                        <div class="plan-name-row">
                          <span class="plan-type-icon">{typeIcon(plan.type)}</span>
                          <span class="plan-name">{plan.name}</span>
                          <span class={`market-badge ${badge.cls}`}>{badge.label}</span>
                        </div>
                        <p class="plan-desc">{plan.description}</p>
                      </div>
                      <div class="plan-price">
                        <span class="price-value">{plan.price}</span>
                        <svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                      </div>
                    </a>
                  );
                })}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Domestic Section -->
      <section class="plans-section">
        <h2 class="section-title">
          <span class="section-icon">🇨🇳</span>
          Domestic
          <span class="company-count">{domestic.length}</span>
        </h2>
        <p class="section-desc">Chinese AI companies and their product plans</p>

        <div class="company-grid">
          {domestic.map((company) => (
            <article class="company-card">
              <div class="card-header">
                <div class="company-title-row">
                  <h3 class="company-name">
                    <a href={company.homepage} target="_blank" rel="noopener noreferrer">{company.name}</a>
                  </h3>
                  <span class="company-markets">{companyMarkets(company.marketsServed)}</span>
                </div>
                <p class="company-desc">{company.description}</p>
              </div>

              <div class="plans-list">
                {company.plans.map((plan) => {
                  const badge = marketBadge(plan.market);
                  return (
                    <a href={plan.url} target="_blank" rel="noopener noreferrer" class="plan-item">
                      <div class="plan-info">
                        <div class="plan-name-row">
                          <span class="plan-type-icon">{typeIcon(plan.type)}</span>
                          <span class="plan-name">{plan.name}</span>
                          <span class={`market-badge ${badge.cls}`}>{badge.label}</span>
                        </div>
                        <p class="plan-desc">{plan.description}</p>
                      </div>
                      <div class="plan-price">
                        <span class="price-value">{plan.price}</span>
                        <svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                      </div>
                    </a>
                  );
                })}
              </div>
            </article>
          ))}
        </div>
      </section>

      <footer class="page-footer-note">
        <p>Prices and plans are subject to change. Data collected from official sources. 
        <a href="https://github.com/cyclone/Shouyu-blog" target="_blank" rel="noopener noreferrer">Submit a correction</a>.</p>
      </footer>
		</main>
		<Footer />
	</body>
</html>

<style>
  /* ── Page Layout ── */
  .llm-plans-page {
    max-width: none;
    padding: 5rem 1.5rem 4rem;
  }

  /* ── Page Header ── */
  .page-header {
    margin-bottom: 3rem;
  }
  .page-header h1 {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .page-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 0.25rem;
  }
  .plan-summary {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.15rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    background-color: var(--color-bg-offset);
    border-radius: 999px;
    color: var(--color-text-muted);
  }
  .last-updated {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0.5rem 0 0;
    opacity: 0.7;
  }

  /* ── Section ── */
  .plans-section {
    margin-bottom: 3rem;
    scroll-margin-top: 5rem;
  }
  .plans-section:last-of-type {
    margin-bottom: 2rem;
  }
  .section-title {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: none;
    padding-bottom: 0;
  }
  .section-icon {
    font-size: 1.4rem;
  }
  .company-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.6rem;
    height: 1.6rem;
    padding: 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    background-color: var(--color-accent);
    color: #fff;
    border-radius: 999px;
  }
  .section-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }

  /* ── Company Grid ── */
  .company-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 1.5rem;
  }

  /* ── Company Card ── */
  .company-card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--color-bg);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .company-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .card-header {
    padding: 1.25rem 1.5rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .company-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .company-name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
  }
  .company-name a {
    color: var(--color-text-main);
    text-decoration: none;
    border: none;
    transition: color 0.2s;
  }
  .company-name a:hover {
    color: var(--color-accent);
  }
  .company-markets {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background-color: var(--color-bg-offset);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .company-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* ── Plans List ── */
  .plans-list {
    display: flex;
    flex-direction: column;
  }
  .plan-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.5rem;
    text-decoration: none;
    color: var(--color-text-main);
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.15s ease;
  }
  .plan-item:last-child {
    border-bottom: none;
  }
  .plan-item:hover {
    background-color: var(--color-bg-offset);
  }

  .plan-info {
    flex: 1;
    min-width: 0;
  }
  .plan-name-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.2rem;
  }
  .plan-type-icon {
    font-size: 0.9rem;
    flex-shrink: 0;
  }
  .plan-name {
    font-size: 0.95rem;
    font-weight: 600;
  }
  .plan-desc {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  /* ── Price ── */
  .plan-price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    text-align: right;
    max-width: 45%;
    word-break: keep-all;
    overflow-wrap: break-word;
  }
  .price-value {
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .arrow-icon {
    color: var(--color-text-muted);
    opacity: 0.4;
    flex-shrink: 0;
    transition: opacity 0.2s, transform 0.2s;
  }
  .plan-item:hover .arrow-icon {
    opacity: 0.8;
    transform: translateX(3px);
  }

  /* ── Market Badges ── */
  .market-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    white-space: nowrap;
    line-height: 1.4;
  }
  .badge-intl {
    background-color: rgba(100, 100, 255, 0.12);
    color: #5555cc;
  }
  :global(html[data-theme="dark"]) .badge-intl {
    background-color: rgba(120, 120, 255, 0.18);
    color: #9999ff;
  }
  .badge-cn {
    background-color: rgba(255, 70, 70, 0.10);
    color: #cc3333;
  }
  :global(html[data-theme="dark"]) .badge-cn {
    background-color: rgba(255, 100, 100, 0.15);
    color: #ff7777;
  }

  /* ── Footer Note ── */
  .page-footer-note {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .page-footer-note p {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0;
    text-align: center;
  }
  .page-footer-note a {
    color: var(--color-accent);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .plan-price {
      max-width: 40%;
    }
  }

  @media (max-width: 720px) {
    .page-header h1 {
      font-size: 1.8rem;
    }
    .company-grid {
      grid-template-columns: 1fr;
    }
    .plan-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
    .plan-price {
      width: 100%;
      max-width: none;
      justify-content: flex-end;
      padding-left: 1.2rem;
    }
    .price-value {
      white-space: normal;
    }
    .plan-desc {
      line-height: 1.45;
    }
    .section-title {
      font-size: 1.2rem;
    }
  }
</style>
